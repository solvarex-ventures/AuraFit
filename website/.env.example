# Point this at your deployed /server (see ../server). Without it, the
# waitlist form and ebook checkout buttons will show a clear "not connected"
# message instead of failing silently.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Razorpay's publishable key (safe to expose client-side) — from the same
# Razorpay dashboard as the server's RAZORPAY_KEY_ID/SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
