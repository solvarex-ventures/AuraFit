{
  "expo": {
    "name": "AuraFit",
    "slug": "aurafit",
    "scheme": "aurafit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurafit.app"
    },
    "android": {
      "package": "com.aurafit.app",
      "adaptiveIcon": {
        "backgroundColor": "#17140F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AuraFit to access your videos so you can upload a lift for AI form-check.",
          "cameraPermission": "Allow AuraFit to use your camera to record a lift for AI form-check."
        }
      ]
    ]
  }
}
