# --- Database ------------------------------------------------------------
# Free Postgres: create a project at supabase.com, then copy its connection
# string (Project Settings -> Database -> Connection string -> URI).
# Run schema.sql against it once (Supabase SQL Editor, or `psql "$DATABASE_URL" -f schema.sql`).
DATABASE_URL=

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- AI providers -----------------------------------------------------
# Gemini: used for multimodal video form-check (cheapest capable option)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI: used as the alternate chat provider / fallback
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Payments -----------------------------------------------------------
# Razorpay: complete business KYC first at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Misc -----------------------------------------------------------------
PORT=4000
# Comma-separated in production if you need more than one origin.
CLIENT_ORIGIN=http://localhost:19006
